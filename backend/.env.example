# Copia este archivo a .env (backend/.env no se sube a git).
# En Render estas mismas variables se configuran en el panel: Environment.

# Firma de los tokens de sesión. Genera una: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Token de LocationIQ (autocompletado de destinos): https://locationiq.com
LOCATIONIQ_TOKEN=

# Base de datos de usuarios. Vacío = SQLite local (urbansafe.db, se pierde en cada redeploy de Render).
# Postgres local (el del docker-compose de la raíz):
#   DATABASE_URL=postgresql://urbansafe:urbansafe_dev@localhost:5432/urbansafe
# Postgres en Render/Neon/Supabase: pega la "External/Connection URL" que te dan.
DATABASE_URL=

# Solo local; Render define PORT por su cuenta
PORT=5000

# TomTom Traffic API: ajusta el ETA de corredores y alimentadores con la congestión en vivo.
# Sin clave el ETA queda sin ajuste (modo "historico"). https://developer.tomtom.com
API_TOMTOM=

# --- Administrador (acceso a Simulación y Dashboard) ---
# Se crea/actualiza solo al arrancar el backend (o a mano: flask --app app seed-admin).
# Con las dos primeras vacías no se crea ningún administrador. Clave: mínimo 8 caracteres.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador
# 0 = no sembrar al arrancar (sigue disponible el comando seed-admin)
SEED_ADMIN_ON_START=1
