  <tag k="description" v="En el Paseo Colón se instaló la &quot;primera&quot; Plaza San Martín, en 1906, con un monumento levantado en homenaje al libertador, donado por el coronel Lorenzo Perez Roca. En 1924 fue trasladado a Barranco, al Paseo Saenz Peña."/>
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Donativo del Coronel Lorenzo Pérez Roca a la Ciudad de Lima 1906."/>
  <tag k="material" v="marble"/>
  <tag k="memorial" v="obelisk"/>
  <tag k="name" v="Monumento a José de San Martín"/>
  <tag k="source" v="https://es-la.facebook.com/637512473006279/photos/existe-en-barranco-desde-el-a%C3%B1o-1924-en-el-cruce-de-las-avenidas-san-martin-y-el/1458242164266635/"/>
  <tag k="start_date" v="1906-08-30"/>
  <tag k="subject:wikidata" v="Q134160"/>
  <tag k="subject:wikipedia" v="es:José de San Martín"/>
 </node>
